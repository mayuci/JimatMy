PGHOST=localhost
PGPORT=5432
PGDATABASE=jimatmy_db
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password
PGSSL=false
GOOGLE_GEOCODING_API_KEY=your_server_side_geocoding_key
GOOGLE_PLACES_API_KEY=your_server_side_places_key
JWT_SECRET=

# Password reset (Gmail SMTP). Leave empty to disable email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=JimatMY

# HMAC secret used to derive password-reset code hashes. Must be at least 16 characters.
PASSWORD_RESET_SECRET=
# Code lifetime in minutes (default 10).
PASSWORD_RESET_CODE_TTL_MINUTES=10
